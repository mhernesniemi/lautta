{
  "description": "Hoikka e-commerce (SvelteKit, Node target)",
  "dockerfile": "node",
  "buildOutput": "build",
  "start": ["node", "build"],
  "copy": ["drizzle"],
  "healthPath": "/api/health",
  "database": "hoikka.db",
  "env": {
    "HOIKKA_TARGET": "node",
    "DATABASE_URL": "/data/hoikka.db",
    "CACHE_DIR": "/data/cache",
    "BODY_SIZE_LIMIT": "209715200",
    "ADDRESS_HEADER": "x-forwarded-for",
    "XFF_DEPTH": "1"
  },
  "originEnv": ["ORIGIN", "PUBLIC_STORE_URL"],
  "secrets": [
    "BETTER_AUTH_SECRET",
    "TASKS_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY"
  ],
  "memory": "768m"
}
